# Database — port 5433 so it does not clash with the `home` project on 5432
DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# Session
COOKIE_NAME=nexus_session
IDLE_TIMEOUT_MINUTES=0
SESSION_TTL_DAYS=30

# Shared password for the five demo accounts, used by the seed script
SEED_PASSWORD=

# Claude — called from the API only, never exposed to the browser
ANTHROPIC_API_KEY=
# live: real calls · replay: serve stored answers, for rehearsals and filming
AI_MODE=live

WEB_ORIGIN=http://localhost:5273
PORT=3100
